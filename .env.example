# Copia este archivo a .env (nunca lo subas al repo). En Netlify estas variables van en Site settings -> Environment variables.

# --- LLM gratuito (opcional). Sin esta clave la app funciona con snapshots (L0) y resumen extractivo (L1). ---
# Clave gratuita de Google AI Studio (sin tarjeta, SIN activar facturación): https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_ENABLED=true
# Máximo de síntesis con IA por IP cada 10 minutos (barrera básica contra abuso)
SYNTH_RATE_MAX=6

# --- NCBI (opcional pero recomendado) ---
NCBI_API_KEY=
NCBI_EMAIL=

# --- Acceso (opcional): si se define, las funciones exigen el encabezado x-access-code ---
ACCESS_CODE=
